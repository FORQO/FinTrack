{
  "sourceLanguage": "en",
  "strings": {
    "/mo": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "/мес."
          }
        }
      }
    },
    "A full snapshot is saved automatically on first launch each day. The 10 most recent are kept. Restoring replaces all current data.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная копия создаётся автоматически при первом запуске за день. Хранятся 10 последних копий. Восстановление заменяет текущие данные."
          }
        }
      }
    },
    "A full snapshot of everything — accounts, transactions, subscriptions, bills, goals, budgets, rules and tags — in a single file. Save one before updating the app, then restore it in one tap.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одном файле сохраняются все счета, операции, подписки, платежи, цели, бюджеты, правила и метки. Сделайте копию перед обновлением, чтобы при необходимости восстановить данные."
          }
        }
      }
    },
